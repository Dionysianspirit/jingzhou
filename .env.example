# 复制本文件为 .env 后填写。不要把 .env 提交到 Git。

LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

EMBED_MODEL=BAAI/bge-small-zh-v1.5

# ---- 以下均为可选，默认值如注释所示 ----

# 检索排序：hybrid 融合（默认）/ dense 仅向量（v0.3 及以前的行为）/ bm25 仅关键词
# RETRIEVAL_MODE=hybrid

# 监听地址。默认只监听本机；需要局域网内其他设备访问时改为 0.0.0.0（服务没有登录，请自行评估）
# HOST=127.0.0.1
# PORT=8777

# 允许跨源调用本机接口的来源，逗号分隔。自带前端是同源的，不需要设置
# CORS_ORIGINS=http://localhost:5173
